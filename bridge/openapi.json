{
  "openapi": "3.0.0",
  "info": {
    "title": "Aivia Edu Bridge",
    "version": "0.2.0",
    "description": "MODE=hybrid|mock. Prefer host-gateway URL for Dify containers. Exchange token required. Never public anonymous exchange."
  },
  "servers": [
    {
      "url": "http://172.22.0.1:18090/bridge/v1",
      "description": "Dify docker host-gateway (dify_default)"
    },
    {
      "url": "http://127.0.0.1:18090/bridge/v1",
      "description": "Host loopback (ops smoke)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "bridge_health",
        "summary": "Health",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/me": {
      "get": {
        "operationId": "bridge_me",
        "summary": "当前教师身份",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "ok" }, "401": { "description": "unauthorized" } }
      }
    },
    "/schools/{school_id}/classes": {
      "get": {
        "operationId": "list_my_classes",
        "summary": "本校班级列表（hybrid=fixture）",
        "parameters": [
          { "name": "school_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "ok" },
          "403": { "description": "cross-tenant" }
        }
      }
    },
    "/schools/{school_id}/courses/{id}": {
      "get": {
        "operationId": "get_course_meta",
        "summary": "课程元数据（hybrid=fixture）",
        "parameters": [
          { "name": "school_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/proposals": {
      "post": {
        "operationId": "create_proposal",
        "summary": "创建变更提案（不写 edu 库）",
        "parameters": [
          { "name": "Authorization", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object" } } }
        },
        "responses": { "201": { "description": "pending" } }
      }
    }
  }
}
