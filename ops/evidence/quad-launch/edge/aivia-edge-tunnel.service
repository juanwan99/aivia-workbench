[Unit]
Description=Aivia workbench reverse tunnel ECS:13080 -> dmit:13080
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ops
# Remote-forward Dify nginx (host loopback) to dmit loopback for edge proxy
ExecStart=/usr/bin/ssh -N \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=4 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -o BatchMode=yes \
  -R 127.0.0.1:13080:127.0.0.1:13080 \
  dmit
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
