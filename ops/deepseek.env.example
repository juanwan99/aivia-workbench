# 复制为本地 .env 或系统环境变量；禁止提交真实 Key
# 优先在 OpenWork/OpenCode 内用 /connect 写入本机 auth，避免明文落盘

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 若上游只认 OpenAI 兼容字段名，可映射：
# OPENAI_API_KEY=          # 填同一 DeepSeek key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-pro

# 完整 JSON 样例见 ops/opencode-deepseek.json.example
